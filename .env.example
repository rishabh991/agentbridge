# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Local Postgres password used by docker compose (any value, it is a throwaway DB).
POSTGRES_PASSWORD=agentbridge

# Claude API key. Not used by M0; the gateway reads it from M1 onwards for the
# chat/agent side. Leave blank and everything except the LLM calls still works.
ANTHROPIC_API_KEY=

# Optional alternative providers (M1+).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
