# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Local Postgres password used by docker compose (any value, it is a throwaway DB).
POSTGRES_PASSWORD=agentbridge

# Claude API key. Not used through M2 — in M1 the gateway is an MCP *server*, so the
# model runs in the client (Claude Code, Claude Desktop, your own agent). M3 adds the
# built-in chat UI, which is the first thing here that calls a provider itself.
ANTHROPIC_API_KEY=

# Audit path: kafka (default) publishes to the topic and projects it back into
# Postgres; direct writes straight to Postgres for hosts that cannot run a broker.
AUDIT_SINK=kafka

# Record argument values in the audit trail as well as field names. Off by default
# on purpose — see the audit section of the README.
AUDIT_LOG_ARGUMENTS=false

# Optional alternative providers (M1+).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
